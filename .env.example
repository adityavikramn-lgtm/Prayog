# Copy the names you need into .env.local (on your computer) or into Vercel → Settings → Environment Variables.
# Never put real values in this file: it is committed to git.

# Needed for /solve to read typed and photographed questions (free key: https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# Only for the voice script (npm run voice): ElevenLabs text-to-speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
